# Local demo configuration. Copy this file to .env before running Docker Compose.
# Values marked CHANGE_ME are placeholders and must not be used in a public deployment.
MYSQL_DATABASE=meeting_checkin
MYSQL_USER=meeting
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PORT=3307

REDIS_PORT=6380

RABBITMQ_USER=meeting
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

AUTH_SECRET=CHANGE_ME_AUTH_SECRET_AT_LEAST_32_CHARS
ENTRY_SECRET=CHANGE_ME_ENTRY_SECRET_AT_LEAST_32_CHARS
HTTP_PORT=8088
